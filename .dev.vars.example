# Copy this file to .dev.vars for local Cloudflare/Vinext development.
# Do not commit .dev.vars. In production, add these through the hosting
# platform's runtime secret settings instead.

# Neon Postgres pooled connection string
DATABASE_URL=

# AWS Rekognition (server-only IAM credentials)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REKOGNITION_COLLECTION_ID=facecheck-collection

# Cloudinary. Reference images are stored as authenticated assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=facecheck/references

# Passcode required before a signed-in visitor can use /adduser.
# Use a long, unique value and keep it only in .dev.vars / runtime secrets.
ADDUSER_PASSCODE=

# Optional calibration values. Start at 95 and validate with consented data.
FACE_MATCH_THRESHOLD=95
FACE_MATCH_MARGIN=3
MAX_IMAGE_BYTES=5000000
